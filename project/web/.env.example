# PostgreSQL connection string (e.g. from Neon, Supabase, Railway, or a local server)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Long random string used to sign login tokens. Generate with: openssl rand -base64 48
JWT_SECRET=""
# Used by `npm run db:seed` to create the first admin account
SEED_ADMIN_EMAIL="admin@tejaschool.in"
SEED_ADMIN_PASSWORD="ChangeMe123!"
